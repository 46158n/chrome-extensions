{
  "manifest_version": 3,
  "name": "URL Cleaner",
  "version": "1.1.0",
  "description": "Cleans URLs by normalizing paths and removing tracking parameters",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "*://*.amazon.co.jp/*",
    "*://*.amazon.com/*",
    "*://rakuten.co.jp/*",
    "*://*.rakuten.co.jp/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
